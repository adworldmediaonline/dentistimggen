# ── Local development config (MongoDB build) ──────────────────────────
# Local MongoDB started via:
#   docker run -d --name dentist-mongo -p 27017:27017 mongo:7
# MONGODB_URI="mongodb://localhost:27017"
MONGODB_URI=
MONGODB_DB=

# App URL (used for absolute links / secure-cookie decision)
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=

# Cloudinary (image storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=

# Postgres Config with Docker
POSTGRES_DB=dentistimggen_db
POSTGRES_USER=dentistimggen
POSTGRES_PASSWORD=password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://dentistimggen:dentistimggen@localhost:5432/dentistimggen_db

GEMINI_API_KEY=

# Resend is intentionally NOT configured — there is no email sending in this build.
